# Copy to web/.env.local (never commit it).

# Which networks the app offers, comma-separated. The first is the default; with more than one,
# a switcher appears in the header.
#   aevum = QDay Aevum testnet (chain 44005)
#   fork  = `make fork`: local copy of Aevum on 127.0.0.1:8555 (chain 440050, real tUSD8)
#   local = `make anvil`: empty local chain on 127.0.0.1:8545 (chain 31337, MockUSD8)
NEXT_PUBLIC_NETWORKS=aevum

# Your TabChannels on each network (printed by `make deploy-aevum`, `make deploy-fork`, `make deploy-local`).
NEXT_PUBLIC_TABS_AEVUM=
NEXT_PUBLIC_TABS_FORK=
NEXT_PUBLIC_TABS_LOCAL=

# Only scan events from this block onward (the "deploy block" the deploy prints). Recommended for aevum:
# unset, the Tabs and Merchant pages only find tabs opened in the last ~10,000 blocks.
NEXT_PUBLIC_DEPLOY_BLOCK_AEVUM=
NEXT_PUBLIC_DEPLOY_BLOCK_FORK=
NEXT_PUBLIC_DEPLOY_BLOCK_LOCAL=

# Optional. Enables WalletConnect (mobile wallets via QR). Free at https://cloud.reown.com
# Without it the app still works with browser-extension wallets (MetaMask, Rabby, …).
NEXT_PUBLIC_WC_PROJECT_ID=

# Optional. Where the Docs page's "Source" link and clone command point (your fork, a preview repo…).
# Default: https://github.com/krisnamic/aevum-tab
NEXT_PUBLIC_REPO_URL=

# ---- Server only (no NEXT_PUBLIC_ prefix: never sent to the browser) ----

# Enables gasless tab opening: this TEST wallet submits the owner's signed deposit and pays the gas.
# Use a fresh wallet with a little tQDAY, never one that holds anything of value. anvil's default keys
# are public: they are accepted only on `make fork` / `make anvil`.
RELAYER_PRIVATE_KEY=

# The merchant behind /api/market: tabs pay this address, and it sends settle/close (needs a little tQDAY).
# Runs on the default network (the first of NEXT_PUBLIC_NETWORKS). Same anvil-key rule as the relayer.
MERCHANT_PRIVATE_KEY=
# Required to settle/close from the Merchant page, except on fork/local where it may stay empty.
MERCHANT_ADMIN_TOKEN=
# Optional. Price per /api/market call in tUSD8. Default 0.001.
# TAB_PRICE=0.001
# Optional. Where the merchant keeps the latest voucher per tab (relative to web/). Default .data/vouchers.json.
# MERCHANT_STORE=.data/vouchers.json

# Optional. Max transactions the relayer sends per day (per server process). Default 500.
# RELAYER_DAILY_TX_LIMIT=500
# Optional. The header your host sets with the real client IP, for the relayer's rate limit.
# Vercel: x-vercel-forwarded-for · Cloudflare: cf-connecting-ip. Unset: last X-Forwarded-For entry.
# TRUSTED_IP_HEADER=
