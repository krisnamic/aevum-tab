# Copy to examples/.env (never commit it).

# RPC to use. Aevum testnet by default; http://127.0.0.1:8555 for `make fork`, http://127.0.0.1:8545 for `make anvil`.
RPC_URL=https://rpc-test.qday.info

# The web app (merchant + relayer). Start it with `pnpm dev`.
API_URL=http://localhost:3000

# Your TabChannels (printed by `make deploy-aevum`, `make deploy-fork` or `make deploy-local`).
TABS_ADDRESS=

# open-tab: the owner wallet that funds the tab (needs tUSD8, no gas). Use a throwaway TEST wallet.
OWNER_KEY=

# agent: the tab and its session key. open-tab prints these three lines for you.
TAB_ID=
AGENT_KEY=

# agent (LLM mode). Without --calls the agent asks Claude which symbols to fetch.
ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-sonnet-5-5
# MAX_TURNS=20

# e2e: only if the web app sets MERCHANT_ADMIN_TOKEN.
MERCHANT_ADMIN_TOKEN=

# check-setup: the address to inspect.
ADDRESS=
